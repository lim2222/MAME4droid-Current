 ///////////////////////////////////////////////////////////////////////////////////////////////
 
+// The Taiko drums are piezo sensors, which give a spike when hit, but the inputs here are keys, which are a
+// level. A key held down kept its sensor at full scale for as long as it was held, and a second sensor hit
+// meanwhile tied with it, so the game took only one of the two (hold P1R Rim, hit P1L Rim -> the left hit
+// never registered). So the Taiko ports record the time of each press (exio_analog_changed) and the sensor
+// reads as a short pulse from that moment, held or not.
+// A sensor that never recorded a press (the analog sticks of other games) reads as the port, unchanged.
+uint16_t namcos10_state::exio_analog_r(offs_t offset)
+{
+	if (offset >= 8)
+		return 0;
+
+	if (m_exio_analog_hit[offset] == attotime::never)
+		return m_exio_analog[offset].read_safe(0);
+
+	constexpr double HOLD = 0.025;  // seconds at full scale
+	constexpr double DECAY = 0.025; // then a linear fall to 0
+	const double age = (machine().time() - m_exio_analog_hit[offset]).as_double();
+	if (age < HOLD)
+		return 0x3ff;
+	if (age < HOLD + DECAY)
+		return uint16_t(0x3ff * (1.0 - (age - HOLD) / DECAY));
+	return 0;
+}
+
+INPUT_CHANGED_MEMBER(namcos10_state::exio_analog_changed)
+{
+	// Only a key going down starts a hit.
+	if (newval && !oldval)
+		m_exio_analog_hit[param] = machine().time();
+}
+
